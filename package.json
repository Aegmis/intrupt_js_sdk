{
  "name": "intrupt-js-sdk",
  "version": "0.0.1-alpha.2",
  "description": "JavaScript/TypeScript client SDK + framework adapters for the human-in-the-loop approval API.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aegmis/intrupt-js-sdk"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vercel": {
      "types": "./dist/adapters/vercelAi.d.ts",
      "import": "./dist/adapters/vercelAi.js",
      "require": "./dist/adapters/vercelAi.cjs"
    },
    "./openai-agents": {
      "types": "./dist/adapters/openaiAgents.d.ts",
      "import": "./dist/adapters/openaiAgents.js",
      "require": "./dist/adapters/openaiAgents.cjs"
    },
    "./mastra": {
      "types": "./dist/adapters/mastra.d.ts",
      "import": "./dist/adapters/mastra.js",
      "require": "./dist/adapters/mastra.cjs"
    },
    "./langchain": {
      "types": "./dist/adapters/langchainTools.d.ts",
      "import": "./dist/adapters/langchainTools.js",
      "require": "./dist/adapters/langchainTools.cjs"
    },
    "./langgraph": {
      "types": "./dist/adapters/langgraph.d.ts",
      "import": "./dist/adapters/langgraph.js",
      "require": "./dist/adapters/langgraph.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.7",
    "@mastra/core": "^1.49.0",
    "@openai/agents": "^0.12.0",
    "ai": "^7.0.15"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    },
    "@langchain/langgraph": {
      "optional": true
    },
    "@mastra/core": {
      "optional": true
    },
    "@openai/agents": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.8",
    "@langchain/openai": "^1.5.3",
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "tsup": "^8.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.6",
    "zod": "^4.4.3"
  }
}
