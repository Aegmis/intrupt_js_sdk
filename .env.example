# intrupt-js-sdk — example environment
#
# Copy to .env and fill in your values. The SDK does NOT load a .env file for
# you — add `import "dotenv/config"` at the very top of your entrypoint (before
# any module that reads these vars), or run with `node --env-file=.env`.

# ── Approvals (core) ─────────────────────────────────────────────────────────
# Base URL of the intrupt approval API.
AEGMIS_BASE_URL=https://api.aegmis.com

# Org API key (dashboard → Account → API Keys). Format: sk_org_{org_id}_{hash}
# — your org is derived from this key, no separate org id needed.
AEGMIS_API_KEY=sk_org_xxxx_yyyy

# Master switch (default: true). Set false (or 0/no/off) to auto-approve
# in-process with no backend call — handy for local dev and tests.
#AEGMIS_APPROVAL=true

# ── Resume callback (agent server) ───────────────────────────────────────────
# Public URL of your agent. The optional createApprovalServer (from
# intrupt-js-sdk/server) derives its listen port from it; also handy for
# building the runner's callbackUrl.
AGENT_PUBLIC_URL=http://localhost:8081

# Random secret verified as X-Agent-Secret on /resume (also the default
# resumeSecret for createApprovalServer). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_RESUME_SECRET=

# ── Observability (optional) ─────────────────────────────────────────────────
# Aegmis Observability endpoint. Zero-code: when set, the SDK auto-initializes
# on the first gated call. Unset → observability is off.
#AEGMIS_OTLP_ENDPOINT=https://obs.aegmis.com

# Kill switch for observability emission (default: true).
#AEGMIS_ENABLE_TRACING=true
